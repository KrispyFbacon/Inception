# NGINX connection settings
events {
	# Maximum simultaneous connections per worker
	worker_connections 1024;
}


# HTTP/HTTPS configuration
http {
	# Load MIME types so NGINX knows the correct Content-Type
	# for files such as HTML, CSS, JavaScript, images, etc.
	include /etc/nginx/mime.types;

    # Default MIME type for files whose type NGINX cannot determine.
	default_type application/octet-stream;


	# 'server' block - Website configuration
    # defines how NGNIX handles requests
	server {
		# Listen for HTTPS connection on port 443
        # 'ssl' enables TLS encryption for these connections.
        # Also listen for IPv6 HTTPS connections on port 443.
		listen 443 ssl;
		listen [::]:443 ssl;

		# Our domain
		server_name frbranda.42.fr;

		# SSL/TLS certificate and private key
		ssl_certificate /etc/nginx/ssl/inception.crt;
		ssl_certificate_key /etc/nginx/ssl/inception.key;

		# Only allow TLS 1.2 and TLS 1.3
		ssl_protocols TLSv1.2 TLSv1.3;

		# WordPress files
		root /var/www/wordpress;
		index index.php index.html;

		# Serve existing files, otherwise return 404
		location / {
			try_files $uri $uri/ =404;
		}

		# Send PHP requests to PHP-FPM
		location ~ \.php$ {
			include snippets/fastcgi-php.conf;
			fastcgi_pass wordpress:9000;
		}
	}
}





		# Listen for HTTPS connections on port 443.
		# 'ssl' enables TLS encryption for these connections.
		listen 443 ssl;

		# Also listen for IPv6 HTTPS connections on port 443.
		listen [::]:443 ssl;


		# Domain name this server block responds to.
		# This matches the DOMAIN_NAME in our .env file
		# and the domain used when generating our certificate.
		server_name frbranda.42.fr;


		# Path to our self-signed SSL/TLS certificate.
		ssl_certificate /etc/nginx/ssl/inception.crt;

		# Path to the private key belonging to the certificate.
		ssl_certificate_key /etc/nginx/ssl/inception.key;


		# Only allow secure TLS versions required by the project.
		# TLS 1.2 and TLS 1.3 are the modern versions we allow.
		ssl_protocols TLSv1.2 TLSv1.3;


		# Directory containing the WordPress website files.
		# This directory is shared with the WordPress container
		# through a Docker volume.
		root /var/www/wordpress;

		# Default files NGINX looks for when a directory is requested.
		# index.php is important because WordPress is mainly PHP.
		index index.php index.html;


		# Handle normal requests such as:
		#   /              -> /var/www/wordpress/
		#   /index.php     -> /var/www/wordpress/index.php
		#
		# $uri = requested file/path.
		# $uri/ = requested directory.
		# If neither exists, return a 404 Not Found.
		location / {
			try_files $uri $uri/ =404;
		}


		# Match requests for PHP files, for example:
		#   /index.php
		#   /wp-login.php
		#   /wp-admin/admin.php
		#
		# NGINX does NOT execute PHP itself.
		# It forwards PHP requests to PHP-FPM.
		location ~ \.php$ {

			# Load Debian's standard FastCGI configuration.
			# This provides parameters needed to pass the PHP request
			# correctly to PHP-FPM.
			include snippets/fastcgi-php.conf;

			# Send PHP requests to the WordPress container
			# on PHP-FPM's port 9000.
			#
			# 'wordpress' is the Docker Compose service name.
			fastcgi_pass wordpress:9000;
		}
	}
}